# Normalize text files to LF in the repository.
* text=auto eol=lf

# Source and build files.
*.c text eol=lf
*.h text eol=lf
*.S text eol=lf
*.s text eol=lf
Makefile text eol=lf
Makefile.* text eol=lf
*.mk text eol=lf
*.sh text eol=lf

# Documentation and configuration.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Keep binary assets untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary
